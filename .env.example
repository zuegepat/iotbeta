# Mock mode needs no cloud accounts. Readings live in memory and reset on restart.
APP_MODE=mock

# Required only with APP_MODE=live. Never prefix secrets with PUBLIC_ or VITE_.
PARTICLE_CLIENT_ID=
PARTICLE_CLIENT_SECRET=
PARTICLE_DEVICE_ID=
# Optional: product ID/slug. Leave blank for a personally owned Sandbox device.
PARTICLE_PRODUCT_ID=
PARTICLE_EVENT_NAME=CounterEvent
PARTICLE_VARIABLE_NAME=counter
PARTICLE_FUNCTION_NAME=setCounter

MONGODB_URI=
MONGODB_DATABASE=iot_starter

# Maximum age of readings. MongoDB TTL cleanup is asynchronous.
READING_RETENTION_DAYS=7

# Set in Render to the exact public HTTPS URL, without a trailing slash.
# APP_ORIGIN=https://your-project.onrender.com
# HOST=0.0.0.0
# PORT=3000
